        <Translation Key="TT_DragDrop">
            <English>Move the object with the mouse into the experiment to place it.</English>
            <German>Verschiebe das Objekt mit der Maus ins Experiment, um es zu platzieren.</German>
        </Translation>

        <Translation Key="TT_ChargeLoad">
            <English>Sets the charge's load.</English>
            <German>Legt die Ladung fest.</German>
        </Translation>        
        
        <Translation Key="TT_ChargePos">
            <English>the charge's position</English>
            <German>die Position der Ladung</German>
        </Translation>

        <Translation Key="TT_ChargeFixPos">
            <English>Specifies wheter the charge will move or if its position will be fixed.</English>
            <German>Legt fest ob sich die Ladung bewegen wird oder ihre Position fixiert ist.</German>
        </Translation>

        <Translation Key="TT_ChargeAdd">
            <English>Adds a new charge with the specified settings.</English>
            <German>Erzeugt eine neue Ladung mit den angegebenen Optionen.</German>
        </Translation>

        <Translation Key="TT_ChargeDelete">
            <English>Deletes the selected charge.</English>
            <German>Löscht die ausgewählte Ladung.</German>
        </Translation>

        <Translation Key="TT_ShowVectorField">
            <English>Specifies whether the vector field is displayed.</English>
            <German>Legt fest ob das Vektorfeld angezeigt wird.</German>
        </Translation>

        <Translation Key="TT_VectorFieldResolution">
            <English>Specifies the vector field resolution.</English>
            <German>Legt die Vektorfeld-Auflösung fest.</German>
        </Translation>

        <Translation Key="TT_ShowVisPlane">
            <English>Specifies whether the visualization plane is displayed.</English>
            <German>Legt fest ob die Visualisierungebene angezeigt wird.</German>
        </Translation>

        <Translation Key="TT_ToggleVoltage">
            <English>Toggles the voltage visualization on the visualization plane.</English>
            <German>Zeigt die Spannungsvisualisierung auf der Visualisierungebene.</German>
        </Translation>

        <Translation Key="TT_ToggleEquiLines">
            <English>Toggles the equipotential line visualization on the visualization plane.</English>
            <German>Zeigt die Äquipotentialkurven-Visualisierung auf der Visualisierungebene.</German>
        </Translation>

        <Translation Key="TT_ModeSwitch">
            <English>Switches between the 2D and 3D mode of the experiment.</English>
            <German>Wechselt zwischen dem 2D und 3D Modus des Experiments.</German>
        </Translation>

        <Translation Key="TT_SwitchPerspective">
            <English>Switches in the 3D mode between the different perspectives.</English>
            <German>Wechselt im 3D Modus zwischen den verschiedenen Ansichten.</German>
        </Translation>

