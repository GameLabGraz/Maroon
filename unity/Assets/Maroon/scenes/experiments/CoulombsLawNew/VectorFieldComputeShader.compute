// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

uniform uint _VectorFieldResolutionX;
uniform uint _VectorFieldResolutionY;
uniform uint _VectorFieldResolutionZ;
uniform RWStructuredBuffer<float4> _VectorFieldBuffer;
uniform float4 _GridMin; // float4 because it seems to be compatible than float3?
uniform float _CellSize;

#include "ElectricFieldShaderUtils.cginc"

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VectorFieldResolutionX * _VectorFieldResolutionY * _VectorFieldResolutionZ)
        return;

    int3 cellIndex = int3(
        id.x % _VectorFieldResolutionX,
        (id.x / _VectorFieldResolutionX) % _VectorFieldResolutionY,
        (id.x / (_VectorFieldResolutionX * _VectorFieldResolutionY) % _VectorFieldResolutionZ));

    float3 pos = _GridMin.xyz + (((float3) cellIndex) + 0.5) * _CellSize;
    float voltage = 0.0;
    float3 fieldValue = float3(0, 0, 0);
    evaluateField(pos, voltage, fieldValue);

    _VectorFieldBuffer[id.x] = float4(fieldValue.x, fieldValue.y, fieldValue.z, voltage);
}
